:null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-16T09:42:57.562Z"}]}]},{"pageSectionId":"208557a3-173d-45aa-97d2-6ec5b1ced795","pageSectionCanonId":"51295b83-cab6-410c-a2b5-47b7268183eb","name":"Co-design","position":1,"pageId":"6d66b113-1565-4492-8780-8dcb4c1c6a48","pageCanonId":"3b4b956e-da36-419d-bf59-c1c0455601af","isVisible":true,"contentBlocks":[{"pageContentBlockId":"4d1d2b8b-6ab1-455a-9ab8-453fec460f6b","pageContentBlockCanonId":"02a33854-898a-4a39-ab77-0196fada3d23","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"208557a3-173d-45aa-97d2-6ec5b1ced795","pageSectionCanonId":"51295b83-cab6-410c-a2b5-47b7268183eb","contentChunks":[{"pageContentChunkId":"e7b5cfa4-8ebf-4421-aabe-fc8dd22c09e3","pageContentChunkCanonId":"9d4628ab-7ded-41a7-a760-1ddefbdfc833","htmlValue":"<p>Co-design supports innovation by involving the people who use a product or service in the creation process and goes beyond traditional user research. Prioritize engaging with people of varied backgrounds and experiences and remember that building with everyone is an ongoing process. By actively engaging with communities that are often overlooked, you can build products that are more beneficial for everyone. Validate your assumptions and discover new opportunities by conducting market research with a broad range of people.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"sh