Fife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-16T09:44:50.041Z"}]},{"pageContentBlockId":"deb32d49-0d3c-4717-b4ad-dad5c1839fc6","pageContentBlockCanonId":"e871bac6-3624-43b6-8bab-e4767037ac54","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"208557a3-173d-45aa-97d2-6ec5b1ced795","pageSectionCanonId":"51295b83-cab6-410c-a2b5-47b7268183eb","contentChunks":[{"pageContentChunkId":"a2e5750f-31fe-49d9-9f4f-cc982e56409e","pageContentChunkCanonId":"10a4923e-3b8d-461c-997d-7e065de6d99d","htmlValue":"<ul><li id=\"isPasted\">What are some opportunities to address user needs keeping in mind attributes of people and their contexts? <ul><li>Who else can benefit from the product? </li><li>What are their needs? </li><li>How are you making sure overlooked communities are included in ongoing testing? </li></ul></li><li>How are you engaging community members and experts early and often throughout the development process? <ul><li>How will their feedback shape key decisions about feature priorities, functionality, and messaging? </li><li>How can you continue to apply these insights as you move from the ideation phase to other stages of product development? </li><li>What are some opportunities to gain even more insights? </li></ul></li><li>What are the risks and potential harms if you exclude people from overlooked communities? <ul><li>How can you address them? </li></ul></li><li>If your tool uses ML or AI, what can you do to mitigate the risk of bias? This <a href=\"https://design.google/library/people-ai-research\" target=\"_blank\" rel=\"noopener noreferrer\">collection of resources</a> can help.</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-16T09:45:31.358Z"}]}]}]}