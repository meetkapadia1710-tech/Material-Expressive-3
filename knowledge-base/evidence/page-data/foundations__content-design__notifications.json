{"pageId":"ece2a187-1cb9-4f47-a0bc-715eb2ad6ccf","pageCanonId":"844999f2-e85f-4f25-bca4-6fb422a3853d","title":"Notifications","slug":"notifications","headerTitle":"Notifications","description":"Notifications help people see information they need or want at the right time","headerAlignment":"LEFT","isDescriptionVisible":true,"updatedTimestamp":"2026-07-17T05:27:27.225Z","headerImageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fmrodixqp-Content%20design.png?alt=media","sections":[{"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","name":"Tab 1","position":0,"pageId":"3e6e9f0d-cdea-4e12-b74f-613ead760edd","pageCanonId":"844999f2-e85f-4f25-bca4-6fb422a3853d","isVisible":true,"contentBlocks":[{"pageContentBlockId":"8ca72c28-5da7-4f07-a688-6ecbfe12a7f5","pageContentBlockCanonId":"a512a4c5-b3bb-427f-96d8-2cf8cc98d408","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"f69df886-828f-4fab-9222-01683f6a3e0e","pageContentChunkCanonId":"1014447b-8bd1-443b-85b7-bfce6628bf40","htmlValue":"<p><span style=\"white-space:pre-wrap\" id=\"isPasted\">Notifications should:</span></p><ul><li><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Be about the user, not the product</span></span></li><li><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Be precise, timely, actionable, contextual, and relevant</span></span></span></li><li><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Give users easy controls to opt out</span></span></span></span></li><li><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Not be used to send unsolicited ads</span></span></span></span></span></li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.160Z"}]},{"pageContentBlockId":"3c307043-aee4-4327-9491-8fd8340adbb6","pageContentBlockCanonId":"f560a425-4156-42a0-a919-26b69d4f8025","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"a33664cd-7f66-4707-ac28-013677f3aeb6","pageContentChunkCanonId":"2ef253e2-fde3-4f7a-bb23-d601d43d94c4","htmlValue":"","footer":"","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53k6lt-1.png?alt=media","imageUrlFife":null,"imageHeight":800,"imageWidth":2048,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.163Z"}]},{"pageContentBlockId":"e7d48bfd-dfa0-429a-a4db-47ecf3201a3d","pageContentBlockCanonId":"ffe7c119-715b-46bc-8d8f-a9fc2f8a1fd8","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"6761f2e2-eafc-4993-a9c1-49e5365b4c62","pageContentChunkCanonId":"7567e3ef-ab61-4ce2-b461-91befcc05139","htmlValue":"<h3 id=\"isPasted\"><span style=\"white-space:pre-wrap\">Put important information at the top</span></h3><p><span style=\"white-space:pre-wrap\" id=\"isPasted\">Put the most important info at the beginning and make it easy to understand. People skim rather than read, often in an F shape. When it makes sense, try to move the most critical information to the front of sentences, rather than the end, where it may get overlooked or truncated.</span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.163Z"},{"pageContentChunkId":"d34b3a0c-b377-41c5-bd52-6faf8d6aeac1","pageContentChunkCanonId":"6b97bdf7-685d-4125-b0da-7b554249f6e3","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Prioritize the most important information</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53kfhk-2.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"Three notifications from Google apps that include the point of the notification in the header.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.163Z"},{"pageContentChunkId":"e6105c5a-c64c-4c51-ab2a-7495c7700abf","pageContentChunkCanonId":"20f858f8-322a-4656-8ad9-200b376aefdb","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Don't waste characters on app names, niceties, or unimportant information</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53kk0k-3.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"Three notifications from Google apps that include app names repeated in the header, instead of important information.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.163Z"}]},{"pageContentBlockId":"5d41fd06-28f9-4f00-b245-76623e4a098e","pageContentBlockCanonId":"460cc07f-547f-4f91-aac3-c8bc51674a88","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"98412b40-c462-4b5a-ba14-54f63e0869b0","pageContentChunkCanonId":"5aff922d-2c1b-4e35-a3fe-46f2cf90bc2f","htmlValue":"<h3 id=\"isPasted\"><span style=\"white-space:pre-wrap\">Tell users what they can do</span></h3><p><span style=\"white-space:pre-wrap\" id=\"isPasted\">If you’re prompting someone to take action, make that clear. CTAs should be concise, specific, and actionable. If you know what motivates people to take action, add it. <br /></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.164Z"},{"pageContentChunkId":"81e3b34d-f829-4928-9f46-391829bfff23","pageContentChunkCanonId":"774037a7-b115-4eb4-a492-1389ae78b3ce","htmlValue":null,"footer":"<p id=\"isPasted\"><span style=\"white-space:pre-wrap\">Clearly guide the user to their next action</span></p><p><br /></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53kq5j-4.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"Two notifications from Google maps that include actionable information in the header.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.164Z"},{"pageContentChunkId":"1468177a-a0f3-4c12-9451-ef175c40c9a5","pageContentChunkCanonId":"c5d135b8-e700-43b0-8a3d-f1d0c963191c","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Don't bury next steps</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53kvqx-5.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"Two notifications from Google apps with non-actionable headers.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.164Z"}]},{"pageContentBlockId":"6fdc92f1-6fd0-4a33-9ee8-2292c69ba734","pageContentBlockCanonId":"30635658-002a-4fcd-b4e0-00f27467e682","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"d60ba5e3-fb84-454f-b741-7f1edbb0ceb5","pageContentChunkCanonId":"586598eb-384b-4464-a220-51df6e60c274","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">Make it relevant and personal</span></h3><p><span style=\"white-space:pre-wrap\" id=\"isPasted\">A notification shouldn’t be sent to everyone. The more you broaden the audience and the message for a notification, the more you risk being irrelevant. Consider user segments, in-app behavior, and personalized information to make sure notifications go to people who will benefit most from them.</span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.165Z"},{"pageContentChunkId":"1e012964-0aac-4aaf-a30b-f6f72b534169","pageContentChunkCanonId":"8d18c1cf-11c1-4087-b20a-7c999c6b4b83","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Be specific to capture user attention</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53l2ot-6.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"A Google maps notification in Memphis, TN that’s personalized to the user’s location downtown.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.165Z"},{"pageContentChunkId":"45c73a4d-442a-492d-ac59-c6674a750bfb","pageContentChunkCanonId":"67622303-08d2-4731-bf0d-101d03d3dac4","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Don’t be so generic as to lose value</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53l86v-7.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"A Google maps notification in Memphis, TN that’s generic to the city, rather than the area.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.165Z"}]},{"pageContentBlockId":"1a273823-0493-4f31-9ee0-1d6483c9a0e3","pageContentBlockCanonId":"f35c68c9-4f3c-4fdc-bc29-b3f3fb32ed98","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"152b1559-4621-436a-ace1-b0df6e9aa32e","pageContentChunkCanonId":"ecb5aaa9-8065-4c20-8447-e61606377fe2","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">Avoid dynamic text</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Dynamic text are words that are implemented by engineering to change based on the user or context, like adding a user’s campaign name to headline or “good afternoon” when users log in at certain times.<br /><br />Try not to use dynamic text in notifications. It often breaks character limits, especially in headlines when translated. Text that gets truncated in the headline will not expand, even in expandable notifications. If you must use dynamic text in the headline, try to pair it with no more than one additional word. Create a backup notification that fits the character count when your primary notification won’t. </span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.166Z"},{"pageContentChunkId":"9e588b44-9721-49b6-b44f-78ee199e2a99","pageContentChunkCanonId":"35a93226-11de-4232-ba70-60de1ec9fcb6","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Place dynamic text in the notification body, where there is more space. If you place dynamic text in the title, keep it very short.</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53lep9-8.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"Two notifications, one with dynamic text in the body, and the other with dynamic text in the header that’s formatted to always be short.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.166Z"},{"pageContentChunkId":"5a71987a-9641-4653-b440-57c49ee6e95a","pageContentChunkCanonId":"c53a646e-ebfa-4957-84a5-f198ddc52e9d","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Don’t place dynamic text in a long notification title</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53lk9g-9.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"Two notifications with dynamic text in the header that’s too long and truncates.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.166Z"}]},{"pageContentBlockId":"71b4f319-6b7b-4124-b17e-56fd0cb2f67f","pageContentBlockCanonId":"61beeb67-aff8-4b9a-b9e2-14a7361254d5","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"df6f5715-0965-431d-acfe-9210cdc3d4fb","pageContentChunkCanonId":"c4a683ab-d65f-4537-bb0a-555f2c26a524","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">Mind your characters</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Stay within these suggested character counts so text doesn’t get cut off:</span></span></p><ul><li><span><span style=\"white-space:pre-wrap\">Title: &lt;29 chars</span></span></li><li><span><span style=\"white-space:pre-wrap\">Collapsed body: &lt;40 chars</span></span></li><li><span><span style=\"white-space:pre-wrap\">Expanded  body: &lt;80 chars; start with collapsed body and add to it</span></span></li><li><span><span style=\"white-space:pre-wrap\">Button: 1-2 buttons (1-2 words each)</span></span></li></ul><p><span><span style=\"white-space:pre-wrap\"><br />There’s more room for text on later versions of Android, but these limits are still recommended to prevent truncation on smaller devices.</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.167Z"},{"pageContentChunkId":"7665dd8d-961c-4656-bedf-414a01e03f1c","pageContentChunkCanonId":"685630c2-73e2-4c71-bdb0-11481283ab81","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Keep notifications short and information-dense</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53ls3l-10.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":1352,"altText":"A short, relevant, and informative notification.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.167Z"}]},{"pageContentBlockId":"72d07eb3-510e-4f87-898e-88df2e6bc35e","pageContentBlockCanonId":"66c640f8-be77-4767-800b-de32a190875e","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"d0fe4fde-579e-4e63-ae14-f1864d3097ff","pageContentChunkCanonId":"422dea58-a42e-4cbd-a3eb-7d45b255d483","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">SMS messages</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">SMS helps users get messages when they might not have access to their Google Account. It’s used for important or urgent communication only. <br /><br />SMS breaks into multiple messages after a certain number of characters, resulting in increased costs. To avoid this, stick to the following character limits:</span></span></p><ul><li><span><span style=\"white-space:pre-wrap\">Latin languages:  &lt;160 characters</span></span></li><li><span><span style=\"white-space:pre-wrap\">Non-latin languages: &lt;134 characters</span></span></li></ul><p><span><span style=\"white-space:pre-wrap\"><br />If translation is needed, let translators know about the character limits in the message description. </span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.168Z"},{"pageContentChunkId":"79f209c3-fdf6-4124-baf6-9a394bdc25e2","pageContentChunkCanonId":"e229c888-2788-4fef-91e6-2e934a22bc91","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">SMS messages should be brief and important</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53lzfr-11.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"An SMS notification that’s brief and truncates sensitive information.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.168Z"},{"pageContentChunkId":"c2983e38-0679-4d8f-ae2d-30603312283b","pageContentChunkCanonId":"8a2d1dd1-8005-42ad-9b59-2edbf9af406d","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Don’t use full emails or website links for text length</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53m528-12.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"An SMS notification that’s too long with too many links.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.168Z"}]},{"pageContentBlockId":"c4afb62b-e017-43a6-9f63-f115e3220056","pageContentBlockCanonId":"f59576bb-4f92-46a8-972b-db6af83b845c","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"f3d0f8fc-edfa-4b30-914a-b31a9146bec6","pageContentChunkCanonId":"3be21f6b-7328-4675-84ad-75717fb9cc16","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">Emoji with caution</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Use emoji sparingly. Many don’t translate and aren’t universally understood across cultures. </span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Experiments</span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"> show that face and hand gesture emoji perform better than generic emoji because they tell a better story. Emoji should enhance content, not replace it.<br /><br />Since it’s not clear to users whether emoji mean we’re sympathizing with them or attempting to project our feelings onto them, don’t use emoji to accentuate bad news. In experiments, there was a strong negative reaction to negative emoji, such as frowning face, anguished face, and weary face.<br /><br />Gen Z adds another cultural nuance to emoji by </span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><a href=\"https://www.textnow.com/blog/the-next-generation-of-emojis-gen-z-explained/\" target=\"_blank\" rel=\"noopener noreferrer\">inventing new meanings</a></span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"> that go beyond the official or literal </span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><a href=\"https://emojipedia.org/\" target=\"_blank\" rel=\"noopener noreferrer\">definitions</a></span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">.</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:45.703Z"},{"pageContentChunkId":"f3217677-7e2c-4695-9c29-4d11ccb85910","pageContentChunkCanonId":"e6b23ab9-26e3-4543-952f-b9a84f21ba46","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Use emoji only to enhance a message</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53mcby-13.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"A notification about coffee with a coffee emoji at the end of the header.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.172Z"},{"pageContentChunkId":"a224120b-a638-4656-a16c-7f8a9e9dc653","pageContentChunkCanonId":"75dcd81c-bf1f-4898-99b2-b17e4a4c100b","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Don’t add negative emotions to a message. Don’t replace words with emoji.</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53mhmr-14.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"A notification about high traffic volume on a route to work that uses upset emoji. A notification about coffee that substitutes a coffee emoji for the word “coffee.”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.172Z"}]},{"pageContentBlockId":"f37d07b3-214d-414a-b8f7-993531bb7afd","pageContentBlockCanonId":"96bd1a5f-5e12-42f3-8c7f-745d66e2e62f","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"fc08db0b-c4c7-4464-85d1-3d0bc61fa6e4","pageContentChunkCanonId":"740b4cfe-3e85-4eb9-aa5b-1e91fef8e1a3","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">Don’t overdo delight</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">What seems funny or cute may not come across that way. When vying for limited user attention, be useful. Don’t focus on delight: delicately added and tested polish can better support Google’s brand.</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.173Z"},{"pageContentChunkId":"ddb02579-d842-4880-9aa8-5a389dd8b26b","pageContentChunkCanonId":"aa3b711b-1ce3-4db8-98c0-4c8874836e8e","htmlValue":null,"footer":"<p id=\"isPasted\"><span style=\"white-space:pre-wrap\">Prioritize straightforward and useful messages</span></p><p><br /></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53mqhm-15.png?alt=media","imageUrlFife":null,"imageHeight":598,"imageWidth":656,"altText":"A notification that’s short and effective","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.173Z"},{"pageContentChunkId":"518d45e2-48e2-4d82-9a62-656ab1f7c896","pageContentChunkCanonId":"7b4ed205-9316-47b8-bd46-db9c3d60a68a","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Jokes aren’t appropriate for notifications</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53mx58-16.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"A notification that’s meant to be funny, but comes across as creepy where the application calls the user “human.”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.173Z"}]},{"pageContentBlockId":"6c3c3eac-8a84-4eb9-a7d2-79117b9a51c9","pageContentBlockCanonId":"19fdae3d-4d7c-49df-9a1c-2b1417f324d9","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"f8eb712e-c968-440d-8195-cd5e745ddeea","pageContentChunkCanonId":"a07eaf45-b9b8-4218-9d71-d639347aedbc","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">Be day-specific</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Use the days of the week. Don’t use “today,” “tomorrow,” “tonight,” or similar words. About 20% of users don’t see notifications on the day they’re sent, so “tomorrow” might be read when it’s “today” for the user.<br /><br />An exception is when a notification auto-dismisses at a specific timestamp.</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.174Z"},{"pageContentChunkId":"1855461d-d510-496f-aa29-f9a1b58437a0","pageContentChunkCanonId":"22830894-7fee-48d2-9619-84a9b572337d","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Specify the day of the week so that it makes sense if someone reads it the following day</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53n553-17.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.174Z"},{"pageContentChunkId":"7a8d585f-bccc-4ac8-a968-08c8436fdf2e","pageContentChunkCanonId":"d94b20e2-2fa8-402c-b438-5333dca0bb7c","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">Don’t use relative terms like “today” or “tomorrow”</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53nb80-18.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.174Z"}]},{"pageContentBlockId":"80592bc1-a1b9-4afc-9c77-2c06217ec2e5","pageContentBlockCanonId":"e806851d-2287-4b9e-99ba-8fd68554e7b2","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"bcac9a01-aba7-4f88-9209-42ea55572f18","pageContentChunkCanonId":"5863b0d4-a99f-4a2c-8ceb-4b2dd4e854db","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">Don’t interrupt the flow</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">If you have notifications or emails related to the onboarding process, make sure they don’t trigger during onboarding.</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updated