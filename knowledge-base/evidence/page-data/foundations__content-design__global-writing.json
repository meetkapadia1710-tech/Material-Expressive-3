{"pageId":"688ea9c4-7b20-401d-a163-ac799333f92c","pageCanonId":"33c706d8-c9b9-4190-a403-d028a56da5cb","title":"Global writing","slug":"global-writing","headerTitle":"Global writing","description":"Global writing is easier to read, understand, and translate. This guidance is for all American English that is localized.","headerAlignment":"LEFT","isDescriptionVisible":true,"updatedTimestamp":"2026-07-17T05:07:22.750Z","headerImageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fmrodiety-Content%20design.png?alt=media","sections":[{"pageSectionId":"bdd4bc1b-63dd-4817-b0e3-f0733675d33d","pageSectionCanonId":"4857554e-9d97-4ac8-a1cc-9cb3f6839a77","name":"Overview","position":0,"pageId":"5fed3eb4-52fa-440d-bd5f-0b1f00b51fd7","pageCanonId":"33c706d8-c9b9-4190-a403-d028a56da5cb","isVisible":true,"contentBlocks":[{"pageContentBlockId":"9de47d05-1271-41e1-95bd-c9ad51760e0b","pageContentBlockCanonId":"831ff099-1a70-4d03-991b-3781522c960f","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"bdd4bc1b-63dd-4817-b0e3-f0733675d33d","pageSectionCanonId":"4857554e-9d97-4ac8-a1cc-9cb3f6839a77","contentChunks":[{"pageContentChunkId":"099f4b42-a75b-4275-9635-5fd2b7c855a2","pageContentChunkCanonId":"c83607e1-1c22-4c90-b255-a0fb9235cbac","htmlValue":"<h2>Overview</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-23T06:32:54.577Z"}]},{"pageContentBlockId":"7b9cc87e-002a-41f0-8927-4fc70d14ffdf","pageContentBlockCanonId":"0d0f8403-e5ff-4579-be74-0c4dbcef7fcb","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"bdd4bc1b-63dd-4817-b0e3-f0733675d33d","pageSectionCanonId":"4857554e-9d97-4ac8-a1cc-9cb3f6839a77","contentChunks":[{"pageContentChunkId":"87705827-9b50-427f-8645-dc46a699f067","pageContentChunkCanonId":"cf9b9eac-a63d-4d0d-86f3-4659a179484d","htmlValue":"<h3>Global writing</h3><p id=\"isPasted\">Global writing is the practice of writing inclusively for many cultures and optimizing for localization. This makes writing easier to read, understand, and translate. Writing for localization is necessary when a product will be translated, but can also be a helpful lens when writing for anyone.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-20T06:30:15.380Z"}]},{"pageContentBlockId":"79116d3f-91bd-4ff9-b4e5-e95ddafb05ee","pageContentBlockCanonId":"d01214d1-5fc0-451f-a5cf-e74021db36e7","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"bdd4bc1b-63dd-4817-b0e3-f0733675d33d","pageSectionCanonId":"4857554e-9d97-4ac8-a1cc-9cb3f6839a77","contentChunks":[{"pageContentChunkId":"1fffd832-9e54-402b-89ed-e6be5cc4e317","pageContentChunkCanonId":"8c4ce2fc-f9c7-40fe-b711-79d752eff5dd","htmlValue":"","footer":"","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo0vnn-1.png?alt=media","imageUrlFife":null,"imageHeight":395,"imageWidth":1024,"altText":"3 apps in different languages.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-11T06:08:28.003Z"}]}]},{"pageSectionId":"d3eeb5dc-bd37-42a7-a660-f372c23fec5e","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","name":"Word choice","position":1,"pageId":"cd398d95-15ae-45ea-a92e-b9e695045e3b","pageCanonId":"33c706d8-c9b9-4190-a403-d028a56da5cb","isVisible":true,"contentBlocks":[{"pageContentBlockId":"97851f40-b27f-43ad-9c31-4dc2aaa77537","pageContentBlockCanonId":"76f5b359-b762-451d-aa72-9e0e3248281e","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"73f15067-6494-41cd-bd2a-9c583b4801d2","pageContentChunkCanonId":"007717b0-849f-4b46-9e4e-ed375a44a3af","htmlValue":"<h2>Word choice</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:50:57.980Z"}]},{"pageContentBlockId":"8991751c-5e82-4484-9aaf-c3b9655a4745","pageContentBlockCanonId":"715006c7-2637-4734-a6e6-d2dc261af528","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"d385c871-09d8-41c9-b744-abb4a8df3ec8","pageContentChunkCanonId":"14967b5b-ef90-494f-aa85-6d82e7728339","htmlValue":"<h3>Use global examples &amp; explain local references</h3><p>References to local places, holidays, and companies won’t always make sense to global audiences.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:03.140Z"},{"pageContentChunkId":"e83d89ca-6353-44b1-bfa6-0327c3e3d2b6","pageContentChunkCanonId":"fbbb9d2f-f76b-43a6-b49f-7d7b627a1ece","htmlValue":null,"footer":"<p>Use generalized, global examples. Most countries and cultures have holidays.</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo362u-1_do.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Empty wishlist screen that references the holidays","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:03.140Z"},{"pageContentChunkId":"13b69995-ae9a-4cab-8a0e-9ad8ee821f3c","pageContentChunkCanonId":"4603bde3-fe93-406e-9c18-f82242d399ce","htmlValue":null,"footer":"<p>Don’t call out a specific country or culture’s holiday</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo41ao-2_don't.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Empty wishlist screen that references Christmas","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:03.140Z"}]},{"pageContentBlockId":"19a8cbd6-4879-45bb-af3b-94bc1e7f274f","pageContentBlockCanonId":"c99bee67-035c-4509-8d91-78e186be213f","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"65f2de7b-0b99-477e-8569-d382aee95508","pageContentChunkCanonId":"2616a777-bef2-42b6-9dc7-35cbd3c33951","htmlValue":"<p>If it doesn’t make sense to use a global example, explain the reference in the message description so the translator can substitute a locale-specific example. Some instances where local references should be called out include:</p><ul><li>Locations</li><li>Names (common first names and nicknames)</li><li>Currencies</li><li>Temperatures</li><li>Date formats</li><li>Providers (internet and cable)</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:11.347Z"},{"pageContentChunkId":"ecd2d03f-e15c-4be6-8271-0007b8bb4d86","pageContentChunkCanonId":"b620a249-82bf-4e90-864f-e4b33790c05f","htmlValue":null,"footer":"<p>Help translators understand the context by adding message descriptions</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo4v88-3.png?alt=media","imageUrlFife":null,"imageHeight":419,"imageWidth":676,"altText":"Empty state that references New York with message description about replacing New York with a well-known city in other languages","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"CAUTION","captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:11.347Z"}]},{"pageContentBlockId":"4d7c4779-097e-41fb-ab79-66ed6ebd9235","pageContentBlockCanonId":"7cd941f4-ffb7-4208-96dc-7d2fa7c28952","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"7fafb25b-15f8-4613-ad29-f9e2879c6e5b","pageContentChunkCanonId":"b639a2cc-e94f-4a7d-ad48-d85da979e80d","htmlValue":"<h3>Use short, simple sentences</h3><p id=\"isPasted\">Break text into shorter sentences. Use bullets or separate content into sections with headings. </p><p>Other languages average at 1.5 times longer than English, so text that’s short may be long when translated.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:18.890Z"},{"pageContentChunkId":"ecaca462-93d4-41e9-8ea5-0385ececdff0","pageContentChunkCanonId":"b34db152-1b82-4134-84e4-1d0142d557ad","htmlValue":null,"footer":"<p>Many languages, like German, are longer than English</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo5uis-4.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":676,"altText":"2 screens side by side, in English and German","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:18.890Z"}]},{"pageContentBlockId":"7bf576e1-3edc-4dae-90da-9b74e080d1f8","pageContentBlockCanonId":"81f24965-a204-492c-ab5f-00f71b0df712","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"d381ac64-a968-4d0d-89c5-ba751a09f061","pageContentChunkCanonId":"43ada19f-2c82-46fb-a6d6-923e932c7f59","htmlValue":"<h3>Avoid abbreviations</h3><p id=\"isPasted\">Abbreviations don’t translate well and can be confusing out of context. Spell things out whenever possible.</p><p>However, common abbreviations for time are acceptable.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:26.947Z"},{"pageContentChunkId":"4bda5814-c85f-4e1e-b00f-c5455710d9cf","pageContentChunkCanonId":"1f915543-dfe7-46e7-866c-a6c7d1e44734","htmlValue":null,"footer":"<p>Use clear names to refer to things</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo6t6b-5_do.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Dialog with options that aren’t abbreviated","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:26.947Z"},{"pageContentChunkId":"dda76444-e6d2-4d53-8dad-c1f4d870363a","pageContentChunkCanonId":"9542c72f-7f6e-47c6-9267-3676488fb817","htmlValue":null,"footer":"<p>Avoid abbreviations. If they're used, provide their meaning in message descriptions.</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo82rh-6.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Dialog with options that are abbreviated","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"CAUTION","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:26.947Z"}]},{"pageContentBlockId":"d5852157-f853-49de-b370-254a06e0e8ad","pageContentBlockCanonId":"0d1f1b19-ca38-4157-a428-dbcfc59c9b6a","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"5ff849af-53b3-4804-9ee0-e51ff372ae7c","pageContentChunkCanonId":"5036c173-28e5-4101-aa8a-da4b5a3c71d6","htmlValue":"<h3>Clarify pronouns</h3><p id=\"isPasted\">Using pronouns, like “it,” can get tricky when translators are working with small, unconnected strings of text and when nouns have genders in many languages. Repeat the noun, or clarify the noun in a message description.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:33.703Z"},{"pageContentChunkId":"3371ef49-5eae-472f-b928-65df195f7249","pageContentChunkCanonId":"953c9ab3-baa6-46fb-8ace-e42f4cc50f0b","htmlValue":null,"footer":"<p>Using nouns instead of, or in addition to, pronouns can help clarify future and past user actions</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo92qu-7_do.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Photo app with snackbar that reads “Couldn’t move photo”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:33.703Z"},{"pageContentChunkId":"9da34e9a-a896-42a1-a292-1aed565904e1","pageContentChunkCanonId":"8cfe66bb-eca8-4fe1-9b99-4002ebc2090a","htmlValue":null,"footer":"<p>Avoid using pronouns when it’s unclear what nouns they’re referring to, especially when explaining user actions</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuoacju-8_don't.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Photo app with snackbar that reads “Couldn’t move it to ‘Travel’ folder because it’s unavailable”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:33.703Z"}]},{"pageContentBlockId":"a77221b1-1ecd-42a3-b0aa-1376811ed8fa","pageContentBlockCanonId":"7f5533e9-c95b-4e8a-adce-90bb4ef01977","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"7ba9aa7c-0fb9-4ee0-b276-189e3a691b61","pageContentChunkCanonId":"20a93065-1a7f-4fbf-afb7-0445460c7a5a","htmlValue":"<h3>Clarify “this” and “that”</h3><p id=\"isPasted\">Don’t start a sentence with \"this\" or \"that\" unless it's immediately followed by the noun. When the noun is unclear, the sentence is more difficult to translate. </p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:41.737Z"},{"pageContentChunkId":"4d553c8a-6018-4f25-94d5-d2adc0aa291f","pageContentChunkCanonId":"37caab7b-4dd8-4126-90ac-0366d424123d","htmlValue":null,"footer":"<p>Make sure it’s clear who text is referring to</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuobsfb-9_do.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Form with clear writing that doesn’t use “this” or “that”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:41.737Z"},{"pageContentChunkId":"52a3b85f-651b-4f43-9421-184348e92957","pageContentChunkCanonId":"d627ebfe-1e35-44ba-91be-faa17d79acf9","htmlValue":null,"footer":"<p>Avoid using “this” and “that”</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuocbnw-10_don't.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Form with a subhead that reads “This can be seen by your IT administrator.” It’s not clear what “this” refers to.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:41.737Z"}]},{"pageContentBlockId":"23fc6807-d1cf-43d5-9854-5ea3c2e7a0a2","pageContentBlockCanonId":"8e70c13a-8008-4a56-a39b-0b1aac7fc2e6","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"22ea9a4a-daaa-4f43-9d54-4c85abf71130","pageContentChunkCanonId":"d62e2dec-7dc2-4d44-a55e-e9c51efc1a38","htmlValue":"<h3>Avoid idiomatic, colloquial, and polite expressions</h3><p id=\"isPasted\">Idiomatic or colloquial phrases can be confusing if the meaning isn’t clear. If you use them, clarify the purpose and context of the phrase to help the translator choose an appropriate alternative.</p><p>Avoid polite expressions, such as “Please,” “Sorry,” and “Thank you,” especially in error messages. However, \"please\" may be used when asking the user to do something inconvenient.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-03T20:23:18.206Z"},{"pageContentChunkId":"fb15d52d-1035-463f-b502-1d66567ceec3","pageContentChunkCanonId":"8c6f188e-72e8-4a62-9dec-718dcf409564","htmlValue":null,"footer":"<p>Clear, everyday language can be used in an expressive and whimsical way when paired with imagery</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fm48wnsm6-11_do.png?alt=media","imageUrlFife":"https://lh3.googleusercontent.com/fbOdPNZxbnWg8h1AtfrVzrHEfx87HqTbn1uV7XqiOCvs017tfdkalXYclDMLKuAlW2fhnxehv4sRAOflGxm7TFe7ckUfdhE57Pkwu57MUkZP=s656","imageHeight":600,"imageWidth":656,"altText":"Empty state with illustration that reads “Let’s go”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-03T20:23:18.206Z"},{"pageContentChunkId":"97e586ab-7569-4814-a7b9-7eb9d520afe8","pageContentChunkCanonId":"cadc1a8d-3da4-489b-be25-68c18c27f2fe","htmlValue":null,"footer":"<p>Idiomatic phrases can be difficult for everyone to understand and for translators to localize</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fm48wp6t5-12_don't.png?alt=media","imageUrlFife":"https://lh3.googleusercontent.com/hIGnwFcZ-4N3wxDr7EvS9-3j_B_l5DbU24maq8wmMOyakUI4sgTD9O-Ab5Ck8oxjJx0samUsMnB-Vlg40cWx6Yx3S9SHTgoqj9uGcQk-yDPv=s656","imageHeight":600,"imageWidth":656,"altText":"Empty state with illustration that reads “Let’s get this party started”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-03T20:23:18.206Z"}]},{"pageContentBlockId":"e7e0fb3b-21ff-4eeb-aa0f-f5be0073099c","pageContentBlockCanonId":"e5b62792-95b0-4ea0-b16c-4f6f90d1805b","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"1dfa6348-427a-44f4-9fc2-33c68eb48cfe","pageContentChunkCanonId":"c30fc19c-0eed-444c-b24b-db1a5099fd6d","htmlValue":"<h3>Reduce technical jargon</h3><p id=\"isPasted\">Technical terms don't always translate. Descriptions should be simple, and in some cases literal, to avoid confusion when translating.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:59.525Z"},{"pageContentChunkId":"6e2d0bad-3a45-4a69-94ec-5631ca4b639d","pageContentChunkCanonId":"64795c70-3989-4609-b895-2051a2ece680","htmlValue":null,"footer":"<p>Plain language is easier for everyone to understand</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuoeiu1-13_do.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Dialog that prompts people to sign up to try new products","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:59.525Z"},{"pageContentChunkId":"864f0165-fe80-46fe-b2c5-0b3c25d77428","pageContentChunkCanonId":"76cffea8-4173-49e6-aaef-98e910fb7c45","htmlValue":null,"footer":"<p>Confusing language makes it difficult for people to understand the actions they’re taking</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuoexnd-14_don't.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"Wordy and confusing dialog that prompts people to sign up for new communication preferences","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:59.525Z"}]},{"pageContentBlockId":"de587f25-bb50-462b-a2d2-8dbc2cf1d473","pageContentBlockCanonId":"842a1090-8f20-4a42-b97e-8743cdc4446a","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"9808b0bb-a62c-46c6-b725-47986ec48a9e","pageContentChunkCanonId":"27a3bfb0-241b-4254-9dd2-d2831d022c0c","htmlValue":"<h3>Clarify ambiguities</h3><p id=\"isPasted\">Some words have multiple meanings. For example, “traffic,” “filter,” and “change” can be used as either nouns or verbs. Avoid using both meanings of the word in the same string or body of text. If a word has the potential to be confusing, provide as much context as possible in the message description so the translation will be accurate.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-20T07:04:31.593Z"},{"pageContentChunkId":"bbee3a26-75b0-4339-bd69-6467615b92ff","pageContentChunkCanonId":"0d802de1-31f2-4aee-bfac-2d28d5354079","htmlValue":null,"footer":"<p>Clarify words that have multiple meanings. “Home” could reference a homepage or where someone lives.</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuoff5i-15.png?alt=media","imageUrlFife":null,"imageHeight":300,"imageWidth":676,"altText":"Screen displaying devices and speakers at home, next to bottom app bar with “home” button","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-20T07:04:31.593Z"}]}]}]}