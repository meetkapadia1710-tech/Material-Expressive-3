9b8c045","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"bc98660c-505f-4028-a2d4-c69a792a372a","pageSectionCanonId":"eea72906-c43a-424e-89c8-e21f23df4e47","contentChunks":[{"pageContentChunkId":"033afc41-2dd5-474a-bf7c-46c0fffc10d0","pageContentChunkCanonId":"d3d54975-f6d7-4e31-b6f3-08759256f13f","htmlValue":"<p id=\"isPasted\">Selections are displayed using a check mark icon, a checkbox component, a change in surface color, or a combination.</p><p>Selections are inherited by the following components: </p><ul><li>Cards</li><li>Checkboxes</li><li>Chips</li><li>Data tables</li><li>Icon buttons</li><li>List items</li><li>Menu items</li><li>Pickers</li><li>Radio buttons</li><li>Segmented buttons</li><li>Sliders</li><li>Switch</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.461Z"},{"pageContentChunkId":"1e9b0869-bc9d-4fb8-8def-b28aa3c63fc6","pageContentChunkCanonId":"c087f00c-3731-4ece-a15b-cb3925319eed","htmlValue":null,"footer":"<p>Selected components:</p><ol><li>Segmented buttons</li><li>Chips</li><li>List items </li><li>Checkboxes</li><li>Radio buttons </li><li>Switch</li><li>Slider</li></ol>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm1qhf1tb-1.png?alt=media","imageUrlFife":null,"imageHeight":644,"imageWidth":1352,"altText":"Seven types of selected  components.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.461Z"}]},{"pageContentBlockId":"c9fea975-a936-4a97-93cb-919e439a0471","pageContentBlockCanonId":"1ac7adaa-dbaf-4745-890f-0747e954851a","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"bc98660c-505f-4028-a2d4-c69a792a372a","pageSectionCanonId":"eea72906-c43a-424e-89c8-e21f23df4e47","contentChunks":[{"pageContentChunkId":"a925bea7-06a8-4d11-a858-2407d8d4a714","pageContentChunkCanonId":"5c586276-c146-4f69-971f-2a516548fdf1","htmlValue":"<p id=\"isPasted\">The following components use an active indicator to represent which item is currently selected:</p><ul><li>Navigation bar</li><li>Navigation drawer</li><li>Navigation rail</li><li>Tabs</li></ul><p>The color and shape of the active indicator varies between components. In these components, only one item should be selected at a time.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.508Z"},{"pageContentChunkId":"02ecd21c-be4a-406e-95b3-8a1214c826d5","pageContentChunkCanonId":"f2749ad4-6b3c-46b6-ba89-ddf038ddfe6f","htmlValue":null,"footer":"<p id=\"isPasted\">Selected components with active indicators:</p><ol><li>Tab</li><li>Navigation drawer</li></ol>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flwvowprh-2.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":1352,"altText":"Tabs and navigation drawer with one destination item selected. Selection is identified with an active indicator.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.508Z"}]},{"pageContentBlockId":"080a76af-1bc0-4929-b968-13cb2edadac8","pageContentBlockCanonId":"f7cd2cda-a189-4661-bf49-774e9e0139d7","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"bc98660c-505f-4028-a2d4-c69a792a372a","pageSectionCanonId":"eea72906-c43a-424e-89c8-e21f23df4e47","contentChunks":[{"pageContentChunkId":"75f19fd4-b303-4f92-834f-d6758548400b","pageContentChunkCanonId":"541dc60f-65be-4caa-8c15-902b365c077d","htmlValue":"<h2><span style=\"white-space:pre-wrap\">Types of selection</span></h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.518Z"}]},{"pageContentBlockId":"4a176e76-e9da-4359-826e-14a5d07126ec","pageContentBlockCanonId":"c69e99ea-37c2-40b2-917e-6ebdf8a33509","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"bc98660c-505f-4028-a2d4-c69a792a372a","pageSectionCanonId":"eea72906-c43a-424e-89c8-e21f23df4e47","contentChunks":[{"pageContentChunkId":"1939eaa9-ecd7-46fd-ad19-8b7dac3b1d08","pageContentChunkCanonId":"4648a1e0-5243-495d-87a3-7014d3856553","htmlValue":"<h3>Touch</h3><p id=\"isPasted\">On touch devices, select items using:</p><ul><li>Long press touch or two-finger touch</li><li>Selection shortcut, if available, such as tapping an avatar</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.527Z"},{"pageContentChunkId":"532e7cdf-88a2-478a-b170-6c0f9e6bb6b5","pageContentChunkCanonId":"ce15ee4c-75b3-44be-b421-09884a8df942","htmlValue":null,"footer":"<p>Items in a list selected via touch</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flfwnm6vf-1P-Touch-2x.png?alt=media","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"Touch used to select 3 list items one after another.","videoUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flwvoyebi-GM3-Foundations-Interaction-Selection-Guidelines-1-v01.mp4?alt=media","videoHeight":1192,"videoWidth":2704,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"VIDEO","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":true,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.527Z"}]},{"pageContentBlockId":"ef766d55-a497-4dee-a8b7-9573bab9ef07","pageContentBlockCanonId":"a84cba29-1367-49c1-9e6d-7a919ae70106","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"bc98660c-505f-4028-a2d4-c69a792a372a","pageSectionCanonId":"eea72906-c43a-424e-89c8-e21f23df4e47","contentChunks":[{"pageContentChunkId":"c5d35c34-63ab-4f0b-89ac-8045b9cce876","pageContentChunkCanonId":"f2180f19-bcae-4354-ae62-7c7e12e17549","htmlValue":"<h3>Entering and exiting selection mode</h3><p id=\"isPasted\">To select an item and enter selection mode, long press the item or use a shortcut, such as tapping the item’s avatar. To select additional items, tap each of them.</p><p>To exit a selection mode, tap each selected item until they’re unselected, or tap an action on the toolbar.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.535Z"},{"pageContentChunkId":"fc4a3eff-3d34-48c2-a88f-115efe8021fe","pageContentChunkCanonId":"9131d805-6daf-4b0d-9c19-659be0aa3bb6","htmlValue":null,"footer":"<p>Entering and exiting selection mode</p>","imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"List items are tapped to select and unselect them.","videoUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flwvozn9v-GM3-Foundations-Interaction-Selection-Guidelines-2-v02.mp4?alt=media","videoHeight":1200,"videoWidth":1312,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"VIDEO","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":true,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.535Z"}]},{"pageContentBlockId":"01d1f3c7-457e-4866-a49d-8eeb1a441ed7","pageContentBlockCanonId":"97a46ad7-9596-4959-ada4-22b9cbb2cc0c","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"bc98660c-505f-4028-a2d4-c69a792a372a","pageSectionCanonId":"eea72906-c43a-424e-89c8-e21f23df4e47","contentChunks":[{"pageContentChunkId":"5b68372a-72f0-49ca-ab8f-098ebaac7114","pageContentChunkCanonId":"9b34308f-6d1e-4cbe-a2a7-1f74fd30fec6","htmlValue":"<h3>Larger selections</h3><p id=\"isPasted\">To select multiple items simultaneously, long press and drag across items. Don’t use this gesture combination if it is already in use to pick up and move items, like cards.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.554Z"},{"pageContentChunkId":"8a596bb7-f8d7-4888-b1af-035e5ab45179","pageContentChunkCanonId":"84f04622-6b7f-4303-8130-a86501084e47","htmlValue":null,"footer":"<p><strong>Long press</strong> and <strong>drag</strong> can be used together to select items in batches</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flfwnntlu-1P%20-%20Larger%20selection-do.png?alt=media","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"Long press and drag used to select multiple images in a photo feed.","videoUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flwvp1iai-GM3-Foundations-Interaction-Selection-Guidelines-3-v01.mp4?alt=media","videoHeight":1984,"videoWidth":1312,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"VIDEO","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":true,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.554Z"},{"pageContentChunkId":"8e385f4c-973d-46be-b844-988b0dd2d645","pageContentChunkCanonId":"4654560f-dafc-47dc-9d8c-9321d4e80866","htmlValue":null,"footer":"<p>If the <strong>long press</strong> and <strong>drag</strong> combination is already in use to pick up and move components, like cards, then the combined gesture can’t also be used for selecting items in batches</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flfwo38nu-1P%20-%20Larger%20selection-dont.png?alt=media","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"Long press and drag combination used to move cards, but can’t be used to batch select items while in use.","videoUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flwvp2p5n-GM3-Foundations-Interaction-Selection-Guidelines-4-v01.mp4?alt=media","videoHeight":1984,"videoWidth":1312,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"VIDEO","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":true,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.554Z"}]},{"pageContentBlockId":"e018953e-10f9-4ac4-a495-7c6812136448","pageContentBlockCanonId":"361b7e9a-b843-412b-80d9-a6ea923dece6","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"bc98660c-505f-4028-a2d4-c69a792a372a","pageSectionCanonId":"eea72906-c43a-424e-89c8-e21f23df4e47","contentChunks":[{"pageContentChunkId":"04dbfa37-c6f2-4474-ba8a-2b98eefee6b1","pageContentChunkCanonId":"3b731176-6396-42eb-a4e2-92cf0ffc6283","htmlValue":"<h3>Click</h3><p id=\"isPasted\">On desktop, checkboxes are always visible when selection is the primary activity. When selection is secondary, checkboxes (or other indicators) are displayed:</p><ul><li>As a single checkbox for that item on hover</li><li>For all items after one item is selected</li></ul><p>To make a selection, hover over an item to reveal a checkbox. The checkbox can then be clicked.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.463Z"},{"pageContentChunkId":"0b9a2211-7734-4136-8696-e34e485c3996","pageContentChunkCanonId":"50fde232-93b7-4479-97d3-a4cad62eb935","htmlValue":null,"footer":"<p>Checkboxes are visible by default in this table because selection is a primary activity</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flfwnp3as-1P%20-%20Click.png?alt=media","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"Checkboxes being selected and unselected.","videoUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm0b935j3-GM3-Foundations-Interaction-Selection-Guidelines-5-v01.mp4?alt=media","videoHeight":1200,"videoWidth":2704,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"VIDEO","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":true,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-08-05T11:54:30.463Z"}]}]}]}