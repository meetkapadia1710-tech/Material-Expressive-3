{"pageId":"eb531546-d13a-47a7-ab95-5c221617243d","pageCanonId":"276f1bd7-d048-49fd-8483-f267f2ece13d","title":"All buttons","slug":"all-buttons","headerTitle":"All buttons","description":"When choosing the right button for an action, consider the level of emphasis each button type provides","headerAlignment":"LEFT","isDescriptionVisible":true,"updatedTimestamp":"2026-07-17T06:58:41.575Z","headerImageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fmrokrjo9-All%20buttons.png?alt=media","sections":[{"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","name":"Tab 1","position":0,"pageId":"b3948a82-f325-4c2e-b3a3-3ec657dd45ff","pageCanonId":"276f1bd7-d048-49fd-8483-f267f2ece13d","isVisible":true,"contentBlocks":[{"pageContentBlockId":"ff2df955-2b76-4563-a011-7ed827f329f3","pageContentBlockCanonId":"808732e9-b710-4982-b91b-31f825bac1c4","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"ebbac7bd-6e2d-4bb8-99cd-a231599f7cec","pageContentChunkCanonId":"7093a93b-f6dd-47f7-96e7-f757512c5953","htmlValue":"<h5><span style=\"white-space:pre-wrap\" id=\"isPasted\">There are 10 types of buttons in Material 3. </span></h5>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.228Z"}]},{"pageContentBlockId":"b30dad83-64a0-4181-b90d-6daf43027884","pageContentBlockCanonId":"9134ac95-678e-49ae-a50a-e71948011b05","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"7d297a0b-5b9e-483b-b7b2-4135eb5be9bb","pageContentChunkCanonId":"d7e528a8-ead2-4110-950f-48da9db95537","htmlValue":null,"footer":"<ol><li><span style=\"white-space:pre-wrap\">Button<br /></span></li><li><span style=\"white-space:pre-wrap\">Toggle button<br /></span></li><li><span style=\"white-space:pre-wrap\">Icon button<br /></span></li><li><span style=\"white-space:pre-wrap\">Toggle icon button<br /></span></li><li><span style=\"white-space:pre-wrap\">Split button<br /></span></li><li><span style=\"white-space:pre-wrap\">Standard button group<br /></span></li><li><span style=\"white-space:pre-wrap\">Connected button group<br /></span></li><li><span style=\"white-space:pre-wrap\">Floating action button (FAB) <br /></span></li><li><span style=\"white-space:pre-wrap\">Extended FAB<br /></span></li><li><span style=\"white-space:pre-wrap\">FAB menu</span></li></ol>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm4kdl8gi-1.png?alt=media","imageUrlFife":null,"imageHeight":1720,"imageWidth":2048,"altText":"10 types of buttons.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.232Z"}]},{"pageContentBlockId":"3e52b43b-ee18-446c-b521-232c1000df52","pageContentBlockCanonId":"8c99bd60-70b4-445e-b8d2-5442dd0fdc8e","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"6942cdd7-da58-4e66-898a-a466103a7076","pageContentChunkCanonId":"38243669-7dbb-4549-a7a5-e63ba73f55d9","htmlValue":"<h2>Choosing buttons</h2><div class=\"table-wrapper\"><table class=\"borderGGrey400\"><thead><tr><th style=\"width:22.4465%;text-align:left\"><p>Level of emphasis</p></th><th style=\"width:13.6474%;text-align:left\"><p>Component</p></th><th style=\"width:51.0869%;text-align:left\"><p>Rationale</p></th><th style=\"width:12.6322%;text-align:left\"><p>Example actions</p></th></tr></thead><tbody><tr><th rowspan=\"4\" style=\"width:22.4638%;vertical-align:top\"><p>High emphasis: For the primary, most important, or most common action on a screen</p></th><td><p><a href=\"/m3/pages/extended-fab/overview/\" target=\"_blank\">Extended FAB</a>, <a href=\"/m3/pages/fab/overview/\" target=\"_blank\">FAB</a>, and <a href=\"/m3/pages/fab-menu/overview\" target=\"_blank\">FAB menu</a><br /></p></td><td><p>The FAB and extended FAB are the largest and most visually prominent buttons. They’re designed for a page’s primary action. The extended FAB is best on large screens. The FAB menu provides multiple options.<br /></p></td><td><p>Create <br />Compose<br />New thread<br />New file<br /></p></td></tr><tr><td><p><a href=\"/m3/pages/common-buttons/guidelines#9ecffdb3-ef29-47e7-8d5d-f78b404fcafe\" target=\"_blank\">Button (filled)</a><br /></p></td><td><p>The filled button’s primary color palette makes it the most prominent button after the FAB. It’s used for final or unblocking actions in a flow.<br /></p></td><td><p>Save<br />Confirm<br />Done<br /></p></td></tr><tr><td><p><a href=\"/m3/pages/split-button/overview\" target=\"_blank\">Split button</a><br /></p></td><td><p>The split button’s primary color palette and menu icon are best used for key actions with multiple options.<br /></p></td><td><p>Send<br />Add<br />Create<br /></p></td></tr><tr><td><p><a href=\"/m3/pages/button-groups/overview\" target=\"_blank\">Button group</a><br /></p></td><td><p>The standard button group uses color, motion, and shape to capture attention. Use it to show multiple key actions.<br /></p></td><td><p>Back, Pause, Next<br /><br /></p></td></tr><tr><th rowspan=\"3\" style=\"vertical-align:top\"><p>Medium emphasis: For important actions that don’t distract users from the main task</p></th><td><p><a href=\"/m3/pages/common-buttons/guidelines#07a1577b-aaf5-4824-a698-03526421058b\" target=\"_blank\">Button (tonal)</a></p></td><td><p>The tonal button has a secondary color palette, making it less visually prominent than a regular, filled button. It can be used for final or unblocking actions, or for supporting actions.<br /></p></td><td><p>Save<br />Confirm<br />Done<br /></p></td></tr><tr><td><p><a href=\"/m3/pages/common-buttons/guidelines#4e89da4d-a8fa-4e20-bb8d-b8a93eff3e3e\" target=\"_blank\">Button (elevated)</a></p></td><td><p>The elevated button has a secondary color palette and a shadow. Only use it when a button requires visual separation from a patterned background.<br /></p></td><td><p>Reply<br />View all<br />Add to cart<br />Take out of trash<br /></p></td></tr><tr><td><p><a href=\"/m3/pages/common-buttons/guidelines#3742b09f-c224-43e0-a83e-541bd29d0f05\" target=\"_blank\">Button (outlined)</a><br /></p></td><td><p>Use an outlined button for actions that need attention but aren’t the primary action, such as “See all” or “Add to cart.” This is also the button to use for giving someone the opportunity to change their mind or escape a flow.</p></td><td><p>Reply<br />View all<br />Add to cart<br />Take out of trash<br /></p></td></tr><tr><th rowspan=\"3\" style=\"vertical-align:top\"><p>Low emphasis: For optional or supplementary actions with the least amount of prominence</p></th><td></td><td><p>The connected button group shows multiple related options. Use it for changing the content visible on a page.<br /></p></td><td><p>Walk, Bike, Drive<br /></p></td></tr><tr><td><p><a href=\"/m3/pages/common-buttons/guidelines#c9bcbc0b-ee05-45ad-8e80-e814ae919fbb\" target=\"_blank\">Button  (text)</a></p></td><td><p>The text button has no outline or fill. It should be used for actions not essential to the user journey.<br /></p></td><td><p>Learn more<br />View all<br />Change account<br />Turn on<br /></p></td></tr><tr><td><p><a href=\"/m3/pages/icon-buttons/overview\" target=\"_blank\">Icon button</a></p></td><td><p>The most compact and subtle type of button, icon buttons are used for optional supplementary actions such as “Bookmark” or “Star.”<br /></p></td><td><p>Add to Favorites Print<br /></p></td></tr></tbody></table></div>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.242Z"}]},{"pageContentBlockId":"c8ad13d9-8aba-4e55-8b07-b2bf1291f57d","pageContentBlockCanonId":"a9ca71a6-bc37-46ea-a768-f9e0c6ecdef2","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"e7d81de6-6cf1-4b6c-9959-358b2993c5f3","pageContentChunkCanonId":"75b4a794-024e-4fd2-bd89-3415e3d6ca47","htmlValue":"<h2>Hierarchy</h2>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.252Z"}]},{"pageContentBlockId":"0b6927f4-9307-4914-a5ca-d873afba08e9","pageContentBlockCanonId":"034147ba-2174-4c0c-bc82-936bcf1394a1","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"1f66dcf9-2e6a-499e-a3dd-b5aaae441f29","pageContentChunkCanonId":"92b799b4-7462-4697-9925-40ceddb34087","htmlValue":"<p dir=\"ltr\"><strong>One high emphasis button</strong></p><p dir=\"ltr\" id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">Each screen should contain a single prominent button for the primary action. This high-emphasis button commands the most attention. The arrangement of on-screen elements should clearly communicate that other buttons are less important.</span></p><p dir=\"ltr\"><br /></p><p dir=\"ltr\"><strong>Other buttons</strong></p><p dir=\"ltr\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">A product can show more than one button at a time in a layout. Use different color styles to create visual hierarchy and indicate the importance of each button.</span></p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":null,"videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.263Z"},{"pageContentChunkId":"db223a95-3c7f-48dd-b662-21f9d147bff3","pageContentChunkCanonId":"969ef389-6988-4a6f-a456-a1acda7a1ed3","htmlValue":null,"footer":"<p>A button’s level of emphasis helps determine its appearance, typography, and placement</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm0gpi7ar-2.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":1352,"altText":"3 types of hierarchy: high emphasis, medium emphasis, and low emphasis.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.263Z"}]},{"pageContentBlockId":"d75943c7-219b-4784-99ef-f62ae575b1aa","pageContentBlockCanonId":"bf5e7b0b-65a4-457f-baef-b48bd7ba775d","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"98056eb5-91ad-42df-8b38-e5b6065a2e4b","pageContentChunkCanonId":"2dc06adc-187f-482d-8a3e-7cd131631713","htmlValue":"<h2 dir=\"ltr\" id=\"isPasted\">Placement</h2>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.272Z"}]},{"pageContentBlockId":"2a3227a6-f69b-4fdb-bb99-18376938b6c5","pageContentBlockCanonId":"a2942905-4661-4003-9efd-21bc680e10c0","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"f8c918e3-5422-4b52-89d7-24c46a89ad66","pageContentChunkCanonId":"5cb43713-f032-45da-ac0e-d6825850e963","htmlValue":"<p dir=\"ltr\" id=\"isPasted\"><span style=\"white-space:pre-wrap\">Use a combination of button styles on the same screen to focus attention on a primary action, while offering alternatives.</span></p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.328Z"},{"pageContentChunkId":"26d99979-50b0-4965-a087-d30d39cd28d7","pageContentChunkCanonId":"3a51b566-230d-4259-8cfb-e535e3dec127","htmlValue":null,"footer":"<ol><li><span style=\"white-space:pre-wrap\">A filled button for a high-emphasis action<br /></span></li><li><span style=\"white-space:pre-wrap\">A text button for a low-emphasis action<br /></span></li><li><span style=\"white-space:pre-wrap\">An extended FAB for the highest emphasis action</span></li></ol>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm4k8798m-3.png?alt=media","imageUrlFife":null,"imageHeight":1112,"imageWidth":1352,"altText":"Newsfeed screen with 3 different types of buttons following the emphasis hierarchy.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.328Z"}]},{"pageContentBlockId":"2f96c345-7eb4-42c9-b708-b93cd965c3bd","pageContentBlockCanonId":"934f01b8-18f2-463f-b12f-18059077f537","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"376a14be-efc5-4e55-b572-d3f5aaa07609","pageContentChunkCanonId":"832d84ab-4db0-4bfe-ba4c-256625c5933e","htmlValue":null,"footer":"<p>For multiple actions, choose a higher-emphasis button for the more important action, such as a filled button next to a text button</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm4k87hb1-4.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":1004,"altText":"Text button to the left of a filled button.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":true,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.333Z"},{"pageContentChunkId":"8ba0c421-4410-4c6d-a173-596c85aaa2d3","pageContentChunkCanonId":"7b7d58a9-288a-4690-9701-7b8addb85859","htmlValue":null,"footer":"<p>When using multiple buttons, you can place an outlined button (medium emphasis) next to a filled button (high emphasis)</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm4k87km1-5.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":1004,"altText":"Outlined button to the left of a filled button.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":true,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.333Z"}]},{"pageContentBlockId":"62cb2ea8-970c-4fa3-bef4-175e7fedaa50","pageContentBlockCanonId":"b9a77de9-133d-4294-883a-cfaf6f9ff106","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"dafcd6b7-e08c-4df4-a7f5-502e7f857364","pageContentChunkCanonId":"a387287d-fd2a-46dc-870b-24c81e1533d3","htmlValue":null,"footer":"<p>When using multiple buttons, you can place a text button (low emphasis) next to an outlined button (medium emphasis)</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm4k87oz2-6.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":1004,"altText":"Text button to the left of an outlined button.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":true,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.342Z"},{"pageContentChunkId":"3f7aace0-df7e-4027-83d1-a95d0caca07b","pageContentChunkCanonId":"75858f05-98c3-41f2-a222-7129a6b821d6","htmlValue":null,"footer":"<p>Use a filled button on its own for a single important action</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm4k87stt-7.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":1004,"altText":"Single filled button at the bottom of a mobile screen.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":true,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.342Z"}]},{"pageContentBlockId":"b36b89a0-829f-485d-ac51-7380240a267b","pageContentBlockCanonId":"8bb3640d-5792-4db2-befe-57139b62ac91","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"03646197-2dad-437f-ba25-c77b9001325d","pageSectionCanonId":"0b0817e5-fa3e-4328-91c1-bba689118103","contentChunks":[{"pageContentChunkId":"4d62dca7-a5dd-490a-9396-e4cfea528dc8","pageContentChunkCanonId":"9d4ff67c-5fe4-4401-906a-8c9640943a40","htmlValue":null,"footer":"<p>Avoid placing a button below another button if there's space to place them side-by-side</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Fm4k87x4t-8.png?alt=media","imageUrlFife":null,"imageHeight":600,"imageWidth":2048,"altText":"Filled button stacked above a text button.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-06-24T07:39:53.350Z"}]}]}]}