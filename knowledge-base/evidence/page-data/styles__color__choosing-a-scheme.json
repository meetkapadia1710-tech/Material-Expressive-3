tic color will be the most like other color workflows you may have used. Static colors won't ever change based on user input or in-app content.</span></p><p>Material provides a static baseline color scheme including default color assignments and mappings.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-04T20:53:23.064Z"},{"pageContentChunkId":"0fff9d27-8c77-4c9e-b864-69335d79b3ca","pageContentChunkCanonId":"983961ea-cdb9-4d88-9520-3d6f3cf5e771","htmlValue":null,"footer":"<p>Colors are static in the baseline color scheme</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fm4ad7ppb-2.png?alt=media","imageUrlFife":"https://lh3.googleusercontent.com/j-JLmGXG9zrnK7fJ7-FsVu1lEpz9oLlYVlRAmaTA3tcI_BYxJETtJ2ukAB5EPokqWwzsKHdBEFBYY11G4tm4BmP64HNPxwybufl2eozWyTE=s1352","imageHeight":1088,"imageWidth":1352,"altText":"Email UI in blue baseline scheme, shown in dark and light theme.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":false,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-04T20:53:23.064Z"}]},{"pageContentBlockId":"46830768-8392-4dc7-adcc-d31d20be7c71","pageContentBlockCanonId":"41cce7f5-357a-4b0f-b9cd-bc7ea921c31d","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"072105b7-9210-4cb2-bd5e-b0f755d98ed0","pageContentChunkCanonId":"a8d478e8-a0bd-4a49-9bdd-369956b4543a","htmlValue":"<p><strong>What you get:</strong></p><p id=\"isPasted\">✓ Accessible colors<br />✓ Pre-made baseline color scheme<br />✓ Colors that won't break an M2 app<br />✓ Ability to easily update to dynamic color in the future</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T18:06:59.326Z"},{"pageContentChunkId":"35c8c525-3495-424b-af36-7a77860f800f","pageContentChunkCanonId":"ad50663b-88f4-469e-93d9-97c7728dd1df","htmlValue":"<p><strong>What you <em>don't</em> get:</strong></p><p id=\"isPasted\">✗ Personalized colors<br />✗ Colors that change based on user's wallpaper or in-app content<br />✗ User-controlled contrast settings</p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T18:06:59.326Z"}]},{"pageContentBlockId":"db45d1f3-9926-4339-aefb-bfcf4cf39111","pageContentBlockCanonId":"534d5625-9560-41c6-b9b9-f234d040d4a6","isHidden":true,"isSqueezed":false,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"d73da210-bae0-409d-85cf-e07f4da64d51","pageContentChunkCanonId":"4d1c08a0-13d5-4a13-b0ee-1052ada4b230","htmlValue":"<p><strong>Products using baseline</strong> (as of Oct 2023)</p><ul><li>Maps</li><li>Search App (Android)</li><li>Home</li><li>Play Store</li><li>Primitives</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-23T13:10:19.830Z"}]},{"pageContentBlockId":"8681e308-c601-40ad-88d0-28bcf4272359","pageContentBlockCanonId":"0ec069b0-9d7f-477c-b952-25f87dc9d225","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"fb47eee5-6cd9-48dc-aad3-f5cb3d8485a0","pageContentChunkCanonId":"fa929b6c-5621-40cb-b71d-9612bdc89028","htmlValue":"<h3 id=\"isPasted\"><strong>Use static (baseline) color if</strong></h3><ul><li>You're not ready to implement dynamic color (though it'll be easy to switch when you are)</li><li>Your product is migrating from M2 and you want to get M3 features without breaking your app</li><li>Your product is for enterprise users who wouldn't benefit from personalized color or user-controlled contrast settings</li><li>Your product is built for iOS</li></ul><p><br /></p><p><strong id=\"isPasted\">Choosing baseline? </strong><a href=\"/m3/pages/static/baseline\"><strong>Start designing with the baseline colors</strong></a></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T19:53:04.106Z"}]},{"pageContentBlockId":"a2758738-3c3a-4a3a-bbc7-7181e902cc4f","pageContentBlockCanonId":"00d5b65d-dd10-42c5-baaf-cd129cc2c1b5","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"0d2617e8-2aee-4789-aed3-9f60436766cf","pageContentChunkCanonId":"e605e09f-3e26-44b2-8e18-eddda1e80673","htmlValue":"<h2>Dynamic color</h2><p>Dynamic color will automatically create an accessible color scheme based on a specific source color.</p><p>Because the UI could end up with any number of different source colors, it's best to initially design it using the baseline color scheme so you can ensure the right color roles are mapped to the right components in your product. You'll use the <app-froala-tooltip-element description=\"Material Theme Builder (MTB) is a Figma plugin that allows markers to emulate the color extraction process for dynamic color and create custom tonal schemes. \" link-label=\"Get the MTB\" link-url=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" should-open-link-in-new-tab=\"true\">Material Theme Builder</app-froala-tooltip-element> to see how your UI mocks look across a range of source colors and adjust it as-needed.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T19:53:28.091Z"},{"pageContentChunkId":"03e3a7a3-93ef-4f87-a48e-75d578d757f4","pageContentChunkCanonId":"ef369518-3c57-47fa-9d22-b799e80b9d2d","htmlValue":null,"footer":"<p>While the actual colors may change, the color role mappings remain the same across dynamic color schemes</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgm3sandbox%2Fimages%2Flmb3ofmk-dynamic-color-animation.gif?alt=media","imageUrlFife":null,"imageHeight":1088,"imageWidth":1352,"altText":"Email UI changing from yellow, to red, to green color schemes,  shown in light and dark theme.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T19:53:28.091Z"}]},{"pageContentBlockId":"c530a5f3-c572-4e61-a11c-55fad3b3609e","pageContentBlockCanonId":"9ba69456-2e99-48f7-b1d5-b00c4a71db69","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"60460bb1-b722-4a75-8432-473ec5decc42","pageContentChunkCanonId":"4b76cd15-c881-4028-b0dd-9c83b2556f94","htmlValue":"<p><strong>What you get:</strong></p><p id=\"isPasted\">✓ Accessible colors<br />✓ Personalized colors that change based on a user's wallpaper or in-app content<br />✓ Ability to use advanced customizations like chroma fidelity to alter the dynamic color output<br />✓ User-controlled contrast settings</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T16:59:14.923Z"},{"pageContentChunkId":"910d6ba6-7710-4432-97d9-43fba986a584","pageContentChunkCanonId":"94471368-97bd-400c-a238-4f5c9e3cf7ee","htmlValue":"<p><strong>What you <em>don't</em> get:</strong></p><p id=\"isPasted\">✗ Exact same UI colors across all devices</p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T16:59:14.923Z"}]},{"pageContentBlockId":"5fcbd951-df13-4f8e-a90e-2bdefcf2bcda","pageContentBlockCanonId":"a19f4c65-002a-4d2f-a1d7-fdd4c4365e40","isHidden":true,"isSqueezed":true,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"24fd0aba-e0c1-49ea-a49b-2100c25e20c9","pageContentChunkCanonId":"c7942eae-3848-4990-92f7-a06612c80421","htmlValue":"<p><strong>Products using dynamic color</strong> (as of Oct 2023)</p><ul><li>Gmail</li><li>Photos</li><li>Keep</li><li>Docs / Slides / Sheets</li><li>Meet</li><li>Assistant</li><li>Translate</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-23T13:10:45.848Z"}]},{"pageContentBlockId":"7c7dc2c2-5e05-4fdb-a09c-494d0a197312","pageContentBlockCanonId":"c4fe52bd-fa12-428a-8619-cf9bb862edf8","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"70031e01-1c3b-4f27-a408-217769199ebd","pageContentChunkCanonId":"c16e35f2-8e86-48ae-ae6a-2bb5e6b6dd74","htmlValue":"<h3 id=\"isPasted\"><strong>Use dynamic color if</strong></h3><ul><li>You want your product to showcase personalization</li><li>You want the colors to change base on a user's wallpaper or in-app content</li><li>You want your product to offer user-controlled contrast settings</li><li>You aren't sure if you'll need to also use a mix of dynamic and static colors (you can customize your color scheme to include static colors as your work progresses)</li></ul><p style=\"box-sizing:border-box;font:400 16px / 1.5rem\"><br /></p><p style=\"box-sizing:border-box;font:400 16px / 1.5rem\"><strong>Choosing dynamic color? Next </strong><a href=\"/m3/pages/dynamic/choosing-a-source\"><strong>pick a dynamic color source</strong></a></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T19:53:41.472Z"}]}]}]}