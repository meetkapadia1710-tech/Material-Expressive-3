a":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.304Z"}]},{"pageContentBlockId":"55c24d15-cef9-434e-b28f-8ca9ebc46c97","pageContentBlockCanonId":"02d4877f-d425-48c4-be27-cf9b8c4832a9","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"b951a9ff-fdc9-433b-bce7-ab4b4e9682d0","pageContentChunkCanonId":"8f5b12c9-44f4-4439-ad56-c1b7a41128ca","htmlValue":"<h2>Design with user-generated color</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.186Z"}]},{"pageContentBlockId":"e41a1f53-d0f4-4fea-b41e-86fc1e4c40aa","pageContentBlockCanonId":"8171346e-1403-4bb5-aebc-9068806af6a8","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"e458bd50-e319-4cbd-9be8-02aefb324e42","pageContentChunkCanonId":"897d12d9-cf16-45b9-b397-aa6f7d2ef1a0","htmlValue":"<p>Because the final colors will be dynamically generated on each user's personal device, <strong>it's more important to understand and apply the system's <app-froala-tooltip-element description=\"Color roles are assigned to UI elements based on emphasis, container type, and relationship with other elements. This ensures proper contrast and usage in any color scheme.\" link-label=\"More on color roles\" link-url=\"/m3/pages/color-roles\" should-open-link-in-new-tab=\"true\">color roles</app-froala-tooltip-element> in your designs</strong> rather than use a particular hex value.</p><p>The easiest way to do this is by using a color scheme generated by the <app-froala-tooltip-element description=\"Material Theme Builder (MTB) is a Figma plugin that allows markers to emulate the color extraction process for dynamic color and create custom tonal schemes. \" link-label=\"Get the MTB\" link-url=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" should-open-link-in-new-tab=\"true\">Material Theme Builder</app-froala-tooltip-element> and focus on applying the color roles to your designs instead of particular hex values. Then you can use the Material Theme Builder to test how well the design functions across potential user-generated color options.</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.311Z"}]},{"pageContentBlockId":"7da5321e-a15c-4488-b2c2-1fe5030ea8b1","pageContentBlockCanonId":"8de327ec-34cd-475f-8931-2a8848d55485","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"743404a6-24e5-4f89-85f9-941fed23be3b","pageContentChunkCanonId":"0a84dbda-0ba6-4573-8624-89bc7fc7a81f","htmlValue":"<h3 id=\"isPasted\">Use Material color roles in new design files</h3><p id=\"isPasted\"><strong>First, get the color roles by creating a new theme with the Material Theme Builder</strong></p><ol id=\"isPasted\"><li>Open your Figma file. Select the <strong>Resources</strong> button in the Figma toolbar</li><li>Find the <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder plugin</a> and select <strong>Run</strong>. This will open a plugin dialog showing the default color scheme, including Core colors and Extended colors.</li><li>Open the plugin's <strong>Settings</strong> (gear icon at lower right of dialog) and select the checkboxes for both <strong>New theme color diagram</strong> and <strong>Generate State Layers</strong>. This will create a handy visualization of your branded color scheme and also generate state layers essential for designing interactions. <a href=\"/m3/pages/interaction-states/state-layers\" rel=\"noopener noreferrer\" target=\"_blank\">Learn more about state layers</a></li><li>Navigate out of settings</li><li>Open the Current Theme dropdown at the top of the dialog and select <strong>+ ADD NEW THEME</strong></li><li>Give your theme a short name (this name will become the prefix of your color roles in Figma)</li><li>Select <strong>ADD THEME</strong></li><li>With <strong>Custom</strong> selected, select <strong>Primary</strong>. This opens a dialog prompting you to select a custom source color.</li><li>Enter the Hex value for a color and hit <strong>Apply</strong>. This will generate a full color scheme.</li><li id=\"isPasted\">With the Current Theme dropdown at the top of the dialog, select your theme</li><li>Select the frames or components in your file and then hit <strong>Swap</strong> in the bottom right of the dialog. This will automatically update the colors for any M3 Design Kit components.</li></ol><p><br /></p><h3>Apply color roles to an existing file or M3 Design Kit components</h3><p><strong>First, get the color roles into your file</strong></p><ol><li id=\"isPasted\">Copy your preferred scheme's color diagram from your <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder</a> file and paste it into your file (this makes the color roles available in the Design panel on the right of the screen as part of your local styles)</li></ol><p><strong>Swap colors in M3 Design Kit components for your preferred colors</strong></p><ol><li>Select the <strong>Resources</strong> button in the Figma toolbar.</li><li>Find the <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder plugin</a> and select <strong>Run</strong>. This will open a plugin dialog showing the default color scheme, including Core colors and Extended colors.</li><li>In the Current Theme dropdown at the top of the dialog, select your color scheme</li><li>Select the frames or M3 Design Kit components in your file that need a color update and then hit <strong>Swap</strong> in the bottom right of the dialog. This will automatically update their colors from baseline colors to your selected scheme colors</li></ol><p><strong>Then, update any remaining non-color-role-based colors</strong></p><ol><li>Manually change any hex values or non-color-role-based color styles by selecting all and looking through the Selection colors in the Design panel on the right of the screen</li><li>Any colors that don't start with your selected scheme name need to be replaced with a corresponding color role</li><li>Hover on a non-color-role-based color row in the Design panel and select the <strong>Style</strong> icon (four dots). This opens a selection dialog.</li><li>Search for your scheme name to see the color roles</li><li>Select the color-role-based color that most closely matches that color's use case (see <a href=\"/m3/pages/color-roles\">Color roles</a> for more information on what color to use where) and select <strong>Use style</strong> to apply it to the selected objects</li><li>Repeat until all non-color-role-based colors in the file have been replaced with color roles</li></ol><p><br /></p><h3 id=\"isPasted\">Try out how your designs will look with dynamic color</h3><ol id=\"isPasted\"><li id=\"isPasted\">Select the <strong>Resources</strong> button in the Figma toolbar.</li><li>Find the <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" rel=\"noopener noreferrer\" target=\"_blank\">Material Theme Builder plugin</a> and select <strong>Run</strong>. This will open a plugin dialog showing the default color scheme, including Core colors and Extended colors.</li><li>Select Dynamic</li><li>Add an image, or select the <strong>Shuffle</strong> icon to get a random source color</li><li>Select the frames or components in your file that you want to see with dynamic color and then hit <strong>Swap</strong> in the bottom right of the dialog. This will automatically update their colors to the user-generated dynamic colors.</li><li>Repeat with a range of colors to get a sense of how your product will appear across different users' devices</li></ol><p><br /></p><p><strong>Need to make adjustments to the scheme? Check out <a href=\"/m3/pages/advanced/overview\">Advanced customizations</a></strong></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.317Z"}]},{"pageContentBlockId":"a2b85ecc-b29e-42da-9f76-1971524e62b3","pageContentBlockCanonId":"930fda61-3471-433c-828d-3f4c031f934c","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"15d80dcc-52b7-4443-ba54-da54fe2b4bf7","pageContentChunkCanonId":"eb8d6c0a-64a6-4322-90ca-ae181033e52c","htmlValue":"<h2>Develop with user-generated color</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.187Z"}]},{"pageContentBlockId":"74116e34-de58-446b-b05e-a439f19c48f4","pageContentBlockCanonId":"602fc8d8-6bb7-4b0c-a652-2aa8e7b6a5bb","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"691397ec-3182-4c13-8a46-3abc58ea9f30","pageContentChunkCanonId":"0b033e4c-efcf-499f-b100-9c92ef9db2e1","htmlValue":"<ul><li><p><a href=\"https://github.com/material-components/material-components-android/blob/master/docs/theming/Color.md\" target=\"_blank\">Android Views (MDC-Android) – Color docs</a></p></li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.324Z"}]}]},{"pageSectionId":"2c20ecf4-0d3d-4b18-85b8-65431fccd3cc","pageSectionCanonId":"4b156b7e-1b18-4194-847c-2ec918f6ce28","name":"Content-based source","position":2,"pageId":"fbb84260-7247-449e-914e-de2e72240c49","pageCanonId":"03571013-d450-49cc-8300-4c7ee70bb4ca","isVisible":true,"contentBlocks":[{"pageContentBlockId":"793c9b2a-3971-415f-8a1c-cacee70fb09b","pageContentBlockCanonId":"54055d14-7418-45a2-aecf-8eb02a3d2db0","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"2c20ecf4-0d3d-4b18-85b8-65431fccd3cc","pageSectionCanonId":"4b156b7e-1b18-4194-847c-2ec918f6ce28","contentChunks":[{"pageContentChunkId":"ba36e69e-a4f7-4eb9-b4a2-f911a7069eba","pageContentChunkCanonId":"d971aa2a-32ec-43a9-a43e-8add022fcb65","htmlValue":"<p id=\"isPasted\"><strong>Content-based color</strong> comes from in-app content, such as an album thumbnail image, logo, or video preview. </p><p>Like user-generated color, the image is digitally analyzed through quantization, a single color selected as the source color, and tones are chosen and assigned to each color role.</p><p><strong id=\"isPasted\">With a dynamic content-based color scheme, end-users see</strong></p><ul><li>The product (and possibly system UI) change to a color corresponding to on-screen imagery</li><li>A product that looks \"smart\"</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.187Z"}]},{"pageContentBlockId":"30b8a79f-1709-495d-8ffe-48f542168ff6","pageContentBlockCanonId":"536928a8-cfa9-424a-bb70-344131b2d58b","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"2c20ecf4-0d3d-4b18-85b8-65431fccd3cc","pageSectionCanonId":"4b156b7e-1b18-4194-847c-2ec918f6ce28","contentChunks":[{"pageContentChunkId":"2fc7f51d-0404-4aa4-aabb-633d37eb7ca6","pageContentChunkCanonId":"bf3acfcb-bc46-4929-a881-25289f656554","htmlValue":"","footer":"<p>Messaging app with content-based color</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Flnoncne7-04.png?alt=media","imageUrlFife":"https://lh3.googleusercontent.com/qkzrtqlq4iJp60o9QNG7Fbl3e8HH4RZHlxkc45WwtZXK29xc19mxYYMsnvfRB0lurUrJSJ3h0wyPqnLj0tcomAV3cPhi3B-QxT7CBGicj86k=s2048","imageHeight":1200,"imageWidth":2048,"altText":"Screenshot of a messaging app on a tablet screen.","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":true,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.331Z"}]},{"pageContentBlockId":"e24dc956-7203-4e2f-b85e-133d109bdd9a","pageContentBlockCanonId":"2da62114-51f2-4e4f-a4e7-4879fb39143b","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"2c20ecf4-0d3d-4b18-85b8-65431fccd3cc","pageSectionCanonId":"4b156b7e-1b18-4194-847c-2ec918f6ce28","contentChunks":[{"pageContentChunkId":"c2b491fc-9d0f-41da-a418-46bda3408487","pageContentChunkCanonId":"e81351d6-44a5-4028-8067-f2248bf825b2","htmlValue":"<h2>Design with content-based color</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.188Z"}]},{"pageContentBlockId":"e3edce53-5c02-497e-912d-e2aafa250a0e","pageContentBlockCanonId":"6612fe8c-5eff-4b93-ac8b-54078f759e81","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"2c20ecf4-0d3d-4b18-85b8-65431fccd3cc","pageSectionCanonId":"4b156b7e-1b18-4194-847c-2ec918f6ce28","contentChunks":[{"pageContentChunkId":"95a83044-5075-4eb9-9e62-992f06eba505","pageContentChunkCanonId":"9dfded3a-fd6d-4d42-8376-2d699988bf31","htmlValue":"<ul><li>Apply content color in apps and areas where it can enhance brand identity and convey the spirit of personalization. </li><li>For example, a music app might derive color from a specific album’s artwork to build upon the personal connection to a music library. For a news feed, content-based color may be applied from a given publication to differentiate brands and help users navigate the platform.</li><li>In-app content provides a color source for any content-based color scheme, and can be applied within a specified area of an app, such as a set of components or a particular screen.</li><li>Get started: Use the color tokens and roles built into the Theme Builder. Check that the preferred scheme is selected when using <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" rel=\"noopener noreferrer\" target=\"_blank\">Material Theme Builder</a> to create color schemes from images.</li><li>Explore advanced customizations</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.337Z"}]},{"pageContentBlockId":"8e62cfa6-f7a4-4a45-be96-1bd8c47bdfd0","pageContentBlockCanonId":"6a44591e-8be5-42da-a17b-58db85e17e13","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"2c20ecf4-0d3d-4b18-85b8-65431fccd3cc","pageSectionCanonId":"4b156b7e-1b18-4194-847c-2ec918f6ce28","contentChunks":[{"pageContentChunkId":"0b58e7a6-d2dd-4373-bd87-31f9bac1ec75","pageContentChunkCanonId":"bc4342f3-6175-4cc5-b88b-5ebb3e6052f9","htmlValue":"<h2 id=\"isPasted\">Develop with content-based color</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.189Z"}]},{"pageContentBlockId":"38299a38-3670-4809-9393-6880954505b0","pageContentBlockCanonId":"0a934947-23ac-4402-9d07-22337406e5aa","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"2c20ecf4-0d3d-4b18-85b8-65431fccd3cc","pageSectionCanonId":"4b156b7e-1b18-4194-847c-2ec918f6ce28","contentChunks":[{"pageContentChunkId":"6668e47f-deaa-4f92-8ac7-1e186ceaeeaf","pageContentChunkCanonId":"1b12b847-c33b-4e23-a9d1-977b16aa527a","htmlValue":"<ul><li>MDC-Android – <a href=\"https://github.com/material-components/material-components-android/blob/master/docs/theming/Color.md#content-based-dynamic-colors\" rel=\"noopener noreferrer\" target=\"_blank\">Content-based dynamic color</a></li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:29:38.883Z"}]}]}]}